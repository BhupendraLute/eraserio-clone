# Database Connection Strings (NeonDB Serverless Postgres)

# Pooled connection string (for serverless Next.js API route handlers & Prisma queries)
# Note: Use sslmode=verify-full & connect_timeout=30 for full security and cold-start support.
DATABASE_URL="postgresql://user:password@ep-cold-boat-aze0hohe-pooler.ap-southeast-1.aws.neon.tech/eraserio-clone-db?sslmode=verify-full&connect_timeout=30"

# Direct connection string (for Prisma CLI migrations & npx prisma db push)
DIRECT_URL="postgresql://user:password@ep-cold-boat-aze0hohe.ap-southeast-1.aws.neon.tech/eraserio-clone-db?sslmode=verify-full&connect_timeout=30"

# Authentication (NextAuth / Auth.js)
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="replace-with-a-random-64-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional — provider buttons are hidden when credentials are empty)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Architecta AI (Slice 5 — AI diagram generation & conversational assistant)
# NOTE: /api/ai/generate requires a signed-in session. Configure NEXTAUTH_SECRET
# and at least one OAuth provider above, or the AI assistant stays blocked for
# everyone (guests get a 401).
# OpenAI-compatible endpoint base URL (defaults to OpenCode Zen).
AI_BASE_URL="https://opencode.ai/zen/v1"
# API key. OPENCODE_ZEN_API_KEY, OPENCODE_API_KEY and OPENAI_API_KEY are also
# accepted when AI_API_KEY is unset.
AI_API_KEY=""
# Model identifier (defaults to OpenCode Zen's free "big-pickle" model).
AI_MODEL="big-pickle"
# Provider Name (defaults to opencode-zen)
AI_PROVIDER_NAME=""

# Rate limiting for /api/ai/generate (per signed-in user, in-memory per process).
# Max requests per user per window:
AI_RATE_LIMIT_MAX="20"
# Window length in milliseconds:
AI_RATE_LIMIT_WINDOW_MS="60000"
